// Version: 1.0.0


println("--- Generador de Secuencia Fibonacci ---")
println("Introduce cuántos números de la secuencia quieres generar:")

var entrada = readLine()
var n = entrada.toInt()

if (n <= 0) then
    println("Error: Por favor, introduce un número positivo.")
else
    // Inicializamos los dos primeros números de la secuencia
    var a = 0
    var b = 1

    println("Los primeros ", n, " números de la secuencia Fibonacci son:")

    // Bucle para generar y mostrar cada número
    for (var i = 0; i < n; i++)
        // Usamos print() para mostrar los números en la misma línea
        print(a)

        // Añade una coma y un espacio si no es el último número
        if (i < n - 1) then
            print(", ")
        end

        // Calculamos el siguiente número y actualizamos los valores
        var siguiente = a + b
        a = b
        b = siguiente
    end

    // Imprime una línea en blanco al final para un formato más limpio
    println()
end
