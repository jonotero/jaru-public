// PhysicTest: rampa infinita con reciclado de cuerpos
use Display, Sprite, Math, Input, Scene

var W = 320
var H = 240
Display.open(W, H)
Display.mode(2) // Modo 2 para backbuffer

var draw = Display.draw
draw.colorBG = 0x101420
draw.color = 0xE0E0E0

// 1. Crear la escena y configurar gravedad global
var mainScene = Scene.new()
mainScene.gravity = 600
mainScene.iters = 5

// --- sprites estaticos / cinematicos ---
var floor1 = Sprite.load("Sprites/sprSuelo.spr")
var floor2 = Sprite.load("Sprites/sprSuelo.spr")
var floor3 = Sprite.load("Sprites/sprSuelo.spr")
var bumper = Sprite.load("Sprites/sprSuelo.spr")

// --- sprites dinamicos reutilizados ---
var box1 = Sprite.load("Sprites/box01.spr")
var box2 = Sprite.load("Sprites/box01.spr")
var box3 = Sprite.load("Sprites/box01.spr")
var ball1 = Sprite.load("Sprites/spr01.spr")
var ball2 = Sprite.load("Sprites/spr01.spr")
var ball3 = Sprite.load("Sprites/spr01.spr")

var bodies = []
var bodyCount = 0
var resetCounter = 0
var kickCounter = 0

// Parametros de la rampa
var RAMP_ANGLE = 20
var RAMP_Y = 170
var OVERLAP = 2

// Coloca los 3 suelos alineados con angulo RAMP_ANGLE.
func placeFloors()
    var segW = floor1.width
    var step = segW - OVERLAP

    var rad = RAMP_ANGLE * (Math.PI / 180.0)
    var ux = Math.cos(rad)
    var uy = Math.sin(rad)

    var cx = W / 2
    var cy = RAMP_Y

    floor1.bodyType = Sprite.STATIC
    floor1.angle = RAMP_ANGLE
    floor1.pos = [cx - step * ux, cy - step * uy]

    floor2.bodyType = Sprite.STATIC
    floor2.angle = RAMP_ANGLE
    floor2.pos = [cx, cy]

    floor3.bodyType = Sprite.STATIC
    floor3.angle = RAMP_ANGLE
    floor3.pos = [cx + step * ux, cy + step * uy]
end

func resetBody(s, idx)
    resetCounter = resetCounter + 1

    var seed = resetCounter + idx * 4.37
    var x = W / 2 + Math.sin(seed * 1.71) * 110
    var y = -35 - Math.sin(seed * 0.83) * 25
    var vx = Math.sin(seed * 2.13) * 190
    var vy = -35 - Math.sin(seed * 1.29) * 45

    s.pos = [x, y]
    s.velocity = [vx, vy]
    s.angle = Math.sin(seed * 0.97) * 180
    // s.spin = Math.sin(seed * 1.43) * 4
end

func addBody(s, idx, elasticity)
    s.bodyType = Sprite.DYNAMIC
    s.mass = 1.0
    s.elasticity = elasticity
    s.friction = 0.1

    resetBody(s, idx)
    mainScene.addSprite(s)
    bodies.append(s)
    bodyCount = bodyCount + 1
end

func bodyIsOutside(s)
    if (s.y > H + 70) then return true end
    if (s.x < -90) then return true end
    if (s.x > W + 90) then return true end
    return false
end

func recycleOutsideBodies()
    for (var i = 0; i < bodyCount; i++)
        if (bodyIsOutside(bodies[i])) then
            resetBody(bodies[i], i)
        end
    end
end

func setBodyFriction(value)
    for (var i = 0; i < bodyCount; i++)
        bodies[i].friction = value
    end
end

func kickBodies()
    kickCounter = kickCounter + 1
    for (var i = 0; i < bodyCount; i++)
        var v = bodies[i].velocity
        var seed = kickCounter + i * 2.41
        var vx = v[0] + Math.sin(seed * 1.8) * 85
        var vy = v[1] - 45 - Math.sin(seed * 0.9) * 25
        bodies[i].velocity = [vx, vy]
    end
end

placeFloors()
mainScene.addSprite(floor1)
mainScene.addSprite(floor2)
mainScene.addSprite(floor3)

bumper.bodyType = Sprite.KINEMATIC
bumper.friction = 0.35
bumper.elasticity = 0.25
bumper.pos = [W / 2, 115]
mainScene.addSprite(bumper)

addBody(box1, 0, 0.35)
addBody(ball1, 1, 0.65)
addBody(box2, 2, 0.4)
addBody(ball2, 3, 0.7)
addBody(box3, 4, 0.45)
addBody(ball3, 5, 0.75)

var lastTime = clock()
var timer = 0.0
var phaseTimer = 0.0
var phase = 0
var impulseTimer = 0.0
var fpsCounter = 0
var lastFpsTime = clock()

while (true)
    var currentTime = clock()
    var deltaTime = (currentTime - lastTime) / 1000.0
    lastTime = currentTime
    timer = timer + deltaTime
    phaseTimer = phaseTimer + deltaTime
    impulseTimer = impulseTimer + deltaTime

    // La rampa respira lentamente para generar contactos distintos.
    RAMP_ANGLE = Math.sin(timer * 0.55) * 24
    RAMP_Y = 168 + Math.sin(timer * 0.37) * 12
    placeFloors()

    // Plataforma movil para que siempre haya colisiones en mitad de pantalla.
    bumper.x = W / 2 + Math.sin(timer * 1.7) * 90
    bumper.y = 108 + Math.sin(timer * 1.1) * 20
    bumper.angle = Math.sin(timer * 1.3) * 14

    // Logica de friccion alternante.
    if (phaseTimer >= 3.0) then
        phase = 1 - phase
        phaseTimer = phaseTimer - 3.0
    end

    if (phase == 0) then
        setBodyFriction(0.05)
    else
        setBodyFriction(0.9)
    end

    // Pequenos impulsos para reactivar cuerpos que hayan perdido energia.
    if (impulseTimer >= 2.4) then
        kickBodies()
        impulseTimer = impulseTimer - 2.4
    end

    recycleOutsideBodies()
    mainScene.update()

    draw.cls()
    draw.scene(mainScene)

    draw.color = 0xA0FFA0
    draw.text(8, 8, "Infinite ramp: " + (phase == 0 ? "LOW FRICTION" : "HIGH FRICTION"))

    draw.color = 0xFFFFFF
    draw.text(8, 25, "RESETS: " + resetCounter.toString())
    draw.text(8, 42, "BODIES: " + bodyCount.toString())

    Display.update()

    fpsCounter++
    currentTime = clock()
    if (currentTime - lastFpsTime >= 1000) then
        println("FPS: ", fpsCounter, "  RESETS: ", resetCounter)
        fpsCounter = 0
        lastFpsTime = currentTime
    end
end
