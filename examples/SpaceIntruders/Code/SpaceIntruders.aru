// Clase para la explosion del UFO
// =======================================================
class UfoExplosion
    def init(x,y)
        this.initime=clock()
        this.sprite=Sprite.new(x,y,imgUFOExplosion)
    end
end

// =======================================================
// Imagen del UFO y de su explosiÃ³n
// =======================================================
var imgUFO = Bitmap.load("Images/space_ufo.bmp");
var imgUFOExplosion=Bitmap.load("Images/ufoExplosion.bmp");

// ======================================================
// CreaciÃ³n de los sprites
// ======================================================
var UFO = Sprite.new(0,40,imgUFO);  // Sprite de la nave UFO
UFO.active=false;                  // UFO inicialmente inactivo
var ufoExplosion=UfoExplosion(0,0); // Sprite de la explosiÃ³n de la nave UFO

// Array de los proyectiles de los invaders
var invaderProjectiles = [];

// Array de las explosiones de los invaders
var invaderExplosions=[];

// Array de los proyectiles del jugador
var projectiles = []

// Array con los invaders
var invaders[11][5]

// Crear los sprites de los invaders en el array
for (var i=0;i<11;i++)
    invaders[i][0]=Sprite.new(10+(i*16),60,imgInvaders[0]);
    invaders[i][0].addImage(imgInvaders[1]);
    invaders[i][0].frameRate=0;

    invaders[i][1]=Sprite.new(10+(i*16),78,imgInvaders[2]);
    invaders[i][1].addImage(imgInvaders[3]);
    invaders[i][1].frameRate=0;

    invaders[i][2]=Sprite.new(10+(i*16),96,imgInvaders[2]);
    invaders[i][2].addImage(imgInvaders[3]);
    invaders[i][2].frameRate=0;

    invaders[i][3]=Sprite.new(10+(i*16),114,imgInvaders[4]);
    invaders[i][3].addImage(imgInvaders[5]);
    invaders[i][3].frameRate=0;

    invaders[i][4]=Sprite.new(10+(i*16),132,imgInvaders[4]);
    invaders[i][4].addImage(imgInvaders[5]);
    invaders[i][4].frameRate=0;
end

// ======================================================================
// Inicia la posicion de los invaders para el comienzo de la partida
// ======================================================================
func IniciarInvaders()
    for (var i=0;i<11;i++)
        invaders[i][0].pos=[10+(i*16),60]
        invaders[i][0].frameRate=0;
        invaders[i][0].active=true

        invaders[i][1].pos=[10+(i*16),78];
        invaders[i][1].frameRate=0;
        invaders[i][1].active=true

        invaders[i][2].pos=[10+(i*16),96];
        invaders[i][2].frameRate=0;
        invaders[i][2].active=true

        invaders[i][3].pos=[10+(i*16),114];
        invaders[i][3].frameRate=0;
        invaders[i][3].active=true

        invaders[i][4].pos=[10+(i*16),132];
        invaders[i][4].frameRate=0;
        invaders[i][4].active=true
    end
    numInvaders=55;
    INVADER_MILLIS=INVADER_MILLIS_MAX;
end

/*
  Disparos de los invaders
*/
func InvaderShoot(invader)
    var newProjectile = ProjectilePlayer(invader.x, invader.y, PROJECTILE_INVADERS_SPEED , imgProjectile_Invaders[0]);
    newProjectile.sprite.addImage(imgProjectile_Invaders[1]);
    newProjectile.sprite.addImage(imgProjectile_Invaders[2]);
    newProjectile.sprite.addImage(imgProjectile_Invaders[3]);
    invaderProjectiles.append(newProjectile);
end

/*
  Disparo del player
*/
func PlayerShoot(ship)
    var bullet = ProjectilePlayer(ship.sprite.x + ship.sprite.width / 2, ship.sprite.y, PBULLET_SPEED, imgProjectile_Player[0]);
    projectiles.append(bullet);
end

func ShowGameOver()
    draw.bitmap(60,50,imgGameOver)
    Display.update();
    pause(2500)
end


/*
  Funcion para mover los invaders.
  La funcion toma como argumento el array de invaders, que es una array de sprites.
*/
func MoveInvaders(invaderArray)
    // Iterar sobre todos los invaders.
    foreach (var iter in invaderArray)
        // Mover cada invader en la direcciÃ³n actual (invaderDirection)
        // multiplicada por la velocidad del invader.
        iter.x=iter.x + invaderDirection * INVADER_SPEED;
        iter.nextFrame() // Avanzar el frame del sprite.
    end

    // Variable booleana para comprobar si algÃºn
    // invader ha golpeado el borde de la pantalla.
    var hitEdge = false;

    foreach (var iter in invaderArray)
        // Si el invader estÃ¡ en el borde izquierdo o derecho de la pantalla,
        // entonces se considera que ha golpeado el borde.
        if (iter.active) then // Solo los sprites estan activos
            if (iter.x <= 0 or iter.x + iter.width >= ANCHO-80) then
                hitEdge = true;
                // Interrumpir el bucle, ya que no necesita verificar mÃ¡s invaders
                // si ya ha encontrado uno que ha golpeado el borde.
                break;
            end
        end;
    end

    // Si algÃºn invader golpeÃ³ el borde de la pantalla, entonces necesitamos
    // cambiar la direcciÃ³n de todos los invaders y moverlos hacia abajo.
    if (hitEdge) then
        // Cambiar la direcciÃ³n de los invaders.
        invaderDirection = -invaderDirection;
        // Mover cada invader hacia abajo 8 px.
        foreach (var iter in invaderArray)
            iter.y+= 8;
            if (iter.active and iter.y>220) then
                PlayerLives=1;
                MSG_PLAYER_DEAD=true;
                MSG_GAME_OVER=true;
                return;
            end;
        end
    end
end

// =================================================================================
// FunciÃ³n de actualizaciÃ³n en movimiento de la nave del player
//
// Simula la toma de decisiones de un jugador humano:
// La nave tiene una probabilidad de continuar en la misma direcciÃ³n,
// una probabilidad de cambiar de direcciÃ³n y una probabilidad de quedarse quieta.
// =================================================================================
func MovePlayerShip(ship)
    var decision = random() mod 100;
    if (decision < 70) then
        // 70% de probabilidad de continuar en la misma direcciÃ³n
        ship.sprite.x+= ship.speed;
    elsif (decision < 85) then
        // 15% de probabilidad de cambiar de direcciÃ³n
        ship.speed = -ship.speed;
        ship.sprite.x+=  ship.speed;
    end // else: 15% de probabilidad de quedarse quieta

    // Comprueba si la nave ha llegado al borde de la pantalla y, de ser asÃ­, invierte la direcciÃ³n
    if (ship.sprite.x <= 0) then
        ship.speed = SHIP_SPEED;
        ship.sprite.x=0;
    end
    if (ship.sprite.x >= 240 - ship.sprite.width) then
        ship.speed = -SHIP_SPEED;
        ship.sprite.x=240 - ship.sprite.width;
    end
end

func HandlePlayerInvaderCollisions()
    var listColi = player.sprite.hits(invaders)
    if (listColi) then
        for (var i=0; i<listColi.size(); i++)
            listColi[i].active=false
            numInvaders--
            println("Invaders : ", numInvaders, "| Num Bullets : ", projectiles.size())
        end
        INVADER_MILLIS = INVADER_MILLIS_MIN + (INVADER_MILLIS_MAX - INVADER_MILLIS_MIN) * numInvaders / TOTAL_INVADERS

        // Limpiar proyectiles activos de los invaders
        foreach (var p in invaderProjectiles)
            p.sprite.active=false
        end
        invaderProjectiles = []

        // Matar al jugador
        MSG_PLAYER_DEAD = true
    end
end


func HandleProjectileShelterCollisions()
    foreach (var projectile in invaderProjectiles)
        if (!projectile.sprite.active) then
            continue
        end
        foreach (var shelter in shelterList)
            var listColi = projectile.sprite.hits(shelter.sprites)
            if (listColi) then
                listColi[0].active=false
                projectile.sprite.active=false
                break
            end
        end
    end
end

func CleanupProjectiles()
    for (var i=invaderProjectiles.size()-1; i>=0; i--)
        if (!invaderProjectiles[i].sprite.active) then
            invaderProjectiles.remove(invaderProjectiles[i])
            return;
        end
    end
end

func HandleProjectileInvaderCollisions()
    if (projectiles.size()) then
        var listCol = projectiles[0].sprite.hits(invaders)
        if (listCol) then
            ProcessInvaderHits(listCol)
            projectiles.remove(projectiles[0])
        end
    end
end


func ProcessInvaderHits(listCol)
    for (var i=0; i<listCol.size(); i++)
        println("TamaÃ±o de los Hits : ", listCol.size())
        listCol[i].active=false
        invaderExplosions.append(InvaderExplosion(listCol[i].x, listCol[i].y))
        var row = (listCol[i].y - invaders[0][0].y) / 18
        numInvaders--
        AddScoreAndAdjustDifficulty(row)
    end
end

func AddScoreAndAdjustDifficulty(invaderType)
    switch (invaderType)
        case 0:     PlayerScore += 30
        case 1, 2:  PlayerScore += 20
        case 3, 4:  PlayerScore += 10
    end

    INVADER_MILLIS = INVADER_MILLIS_MIN + (INVADER_MILLIS_MAX - INVADER_MILLIS_MIN) * numInvaders / TOTAL_INVADERS
end


func HandleProjectileUFOCollisions()
    if (UFO.active and projectiles.size()>0) then
        if (projectiles[0].sprite.hits(UFO)) then
            UFO.active=false
            ufoExplosion.sprite.pos=[UFO.x, UFO.y]
            ufoExplosion.sprite.active=true
            ufoExplosion.initime = clock()
            projectiles.remove(projectiles[0])
            PlayerScore += UFO_SCORES[random(0, UFO_SCORES.size()-1)]
        end
    end
end


func HandlePlayerHit(projectil)
    println("HandlePlayerHit")

    // Eliminar el proyectil que impactÃ³
    invaderProjectiles.remove(projectil)

    // Limpiar el resto de proyectiles activos
    foreach (var p in invaderProjectiles)
        p.sprite.active=false
    end
    invaderProjectiles = []

    println("Player alcanzado")
    MSG_PLAYER_DEAD = true
end

/**
 * Esta funciÃ³n verifica las colisiones entre los invasores y las construcciones
 * Si una colisiÃ³n se detecta, el invasor y la secciÃ³n de la construcciÃ³n en la que colisionÃ³ se desactivarÃ¡n.
 */
func CheckInvaderShelterCollisions()
    foreach (var invader in invaders)
        if (invader.active and invader.y >= 168) then
            foreach (var shelter in shelterList)
                var listColi = invader.hits(shelter.sprites)
                if (listColi) then
                    listColi[0].active=false
                end
            end
        end
    end
end

// =========================================================================================
// FunciÃ³n: CheckCollisions
// DescripciÃ³n: Detecta y maneja las colisiones del juego.
// Los objetos implicados incluyen al jugador, los invasores, los proyectiles y la nave UFO.
// =========================================================================================
func CheckCollisions()
    var listCol

    // Detecta las colisiones entre el jugador y los disparos de los invaders
    foreach (var projectil in invaderProjectiles)
        if (projectil.sprite.hits(player.sprite)) then
            HandlePlayerHit(projectil)
            return
        end
    end

    // Detecta colisiones entre el jugador y los invasores
    HandlePlayerInvaderCollisions()

    // Detecta colisiones entre los proyectiles de los invasores y las construcciones
    HandleProjectileShelterCollisions()

    // Elimina los proyectiles que han colisionado
    CleanupProjectiles()

    // Detecta colisiones entre el proyectil del jugador y los invasores
    HandleProjectileInvaderCollisions()

    // Detecta colisiones entre el proyectil del jugador y la nave UFO
    HandleProjectileUFOCollisions()

    // Detecta colisiones entre los invaders y las construcciones
    CheckInvaderShelterCollisions()
end

// ==============================================================================================
// FunciÃ³n que se encarga de la lÃ³gica de los invasores (movimiento, disparo y explosiones)
// ==============================================================================================
func UpdateInvaders(current_time)

    MoveInvaders(invaders);
    HandleInvaderExplosions(current_time);
    // Invaders disparando
    if (invaderProjectiles.size()< MAX_PROJECTILE_INVADERS) then
        foreach (var invader in invaders)
            if (invader.active and random(0,100000) mod 100 < INVADER_SHOOT_PROBABILITY) then
                InvaderShoot(invader);
            end
        end
    end
end

// ==============================================================================================
// FunciÃ³n que se encarga de la lÃ³gica del jugador (movimiento y disparo)
// ==============================================================================================
func UpdatePlayerAndProjectiles()
    MovePlayerAndProjectiles();
    // Actualizar proyectiles de los invaders
    // var ProjectilesList
    foreach (var projectile in invaderProjectiles)
        projectile.update();
        if (projectile.sprite.y > ALTO) then
            invaderProjectiles.remove(projectile);
            break;
        end
    end
end

// ==============================================================================================
// FunciÃ³n que se encarga del movimiento y las explosiones de la nave UFO
// ==============================================================================================
func UpdateUFO(current_time)
    var UFO_SPEED = 2;
    // Mover la nave UFO
    if (UFO.active) then
        UFO.x = UFO.x + ufoDirection * UFO_SPEED;

        // Desactivar el UFO si se mueve fuera de la pantalla
        if (ufoDirection > 0 and UFO.x + UFO.width > ANCHO) then
            UFO.active=false;
        elsif (ufoDirection < 0 and UFO.x < 0) then
            UFO.active=false;
        end

    end
    HandleUFOExplosions(current_time);
end


// ==============================================================================================
// FunciÃ³n para activar la nave UFO
// ==============================================================================================
func ActivateUFO()
    UFO.active=true;
    // Alternar la direcciÃ³n en que se moverÃ¡ el UFO
    ufoDirection = -ufoDirection;
    if (ufoDirection > 0) then
        UFO.x=0;  // iniciar desde la izquierda
    else
        UFO.x=ANCHO - UFO.width;  // iniciar desde la derecha
    end
end

// =======================================================================
// Mueve el jugador y actualiza los proyectiles
// =======================================================================
func MovePlayerAndProjectiles()
    MovePlayerShip(player);

    // Actualiza cada proyectil y elimina aquellos que estÃ¡n fuera de la pantalla
    foreach (var projectile in projectiles)
        projectile.update();
        if (projectile.sprite.y < 5) then
            projectiles.remove(projectile);
        end
    end

    // Si no hay proyectiles en pantalla, el jugador tiene una pequeÃ±a probabilidad de disparar
    if (projectiles.size() < 1 and random() mod 100 < 2) then
        PlayerShoot(player);
    end
end

// =======================================================================
// Gestiona las explosiones de invasores
// =======================================================================
func HandleInvaderExplosions(current_time)
    foreach (var iter in invaderExplosions)
        if (current_time - iter.initime > 300) then
            invaderExplosions.remove(iter);
            break;
        end
    end
end

// =======================================================================
// Gestiona la explosion del UFO
// =======================================================================
func HandleUFOExplosions(current_time)
    if (current_time - ufoExplosion.initime > 500) then
        ufoExplosion.sprite.active=false;
    end
end

// ===============================================================================
// Se encarga de una sola responsabilidad: dibujar los elementos del juego
// ===============================================================================
func DrawGame()
    // Dibujar el sprite del jugador
    if (!MSG_PLAYER_DEAD) then
        draw.sprite(player.sprite);
    end

    // Dibujar los proyectiles del player
    foreach (var iter in projectiles)
        draw.sprite(iter.sprite);
    end

    // Dibujar las explosiones de los invasores
    foreach (var iter in invaderExplosions)
        draw.sprite(iter.sprite);
    end

    // Dibujar los invasores
    draw.sprite(invaders);

    // Dibujar los sprites de los proyectiles de los invasores
    foreach (var projectile in invaderProjectiles)
        draw.sprite(projectile.sprite)
    end

    // Dibujar el UFO si estÃ¡ activo
    if (UFO.active) then
        draw.sprite(UFO);
    // Dibuja la explosion del UFO si ha sido alcanzado
    elsif (ufoExplosion.sprite.active) then
        draw.sprite(ufoExplosion.sprite);
    end

    // Construcciones de proteccion del player
    foreach (var iter in shelterList)
        draw.sprite(iter.sprites)
    end

    // Mostrar el score en pantalla
    draw.text(10,5, "SCORE <1> HI-SCORE")
    draw.text(34,20,PlayerScore.toString()+"        " + HiScore.toString())

    // Si se ha producido el Game Over pintarlo, pausar y salir.
    if (MSG_GAME_OVER) then
        ShowGameOver();
        return
    end;

    // Actualizar la pantalla
    Display.update();
    //println("Memoria Usada: ",memUse())
    //println("Memoria Libre: ",memFree())

end

// ===========================================================================
// FunciÃ³n de actualizaciÃ³n del juego que se llamarÃ­a en cada fotograma
// ===========================================================================
func UpdateGame()
    var current_time = clock()

    // Mueve la nave del jugador y gestiona los proyectiles
    if (current_time - lastPlayerMoveTime > 25) then
        UpdatePlayerAndProjectiles();
        lastPlayerMoveTime = current_time
    end;

    // Detecta colisiones entre el jugador y los invasores
    if (current_time - lastCollisionCheck > 30) then
        CheckCollisions();
        lastCollisionCheck = current_time
    end;

    // Mueve los invasores
    if (current_time - lastInvaderMoveTime > INVADER_MILLIS) then
        UpdateInvaders(current_time)
        lastInvaderMoveTime = current_time
    end



    // Controla el movimiento y las explosiones de la nave UFO
    if (current_time - lastUFOMoveTime > 35) then
        UpdateUFO(current_time);
        lastUFOMoveTime=current_time;
    end

    // Activar la nave UFO cada 20 segundos
    if (current_time - lastUFOActiveTime > 20000) then
        println("Ufo Activado!!!!");
        ActivateUFO();
        lastUFOActiveTime = current_time;
    end
end

// ===============================================
// Iniciar una partida
// ===============================================
func InitGame()
    INVADER_SPEED = 2;          // Velocidad inicial de los invasores
    INVADER_MILLIS=INVADER_MILLIS_MAX;
    invaderDirection = 1;       // DirecciÃ³n inicial de los invasores
    ufoDirection = 1;           // DirecciÃ³n en la que se moverÃ¡ la nave UFO
    IniciarInvaders();

    // Iniciar los shelters
    foreach (var shelter in shelterList)
        shelter.reset();
    end;

    // Actualizar el Hi-Score si procede.
    if (PlayerScore > HiScore) then
        HiScore=PlayerScore
    end;

    PlayerScore=0;
end;

// ===================================================================================================================
//                                                  Main
// ===================================================================================================================
// Inicio de pantalla
Display.viewWidth=240;
Display.viewHeight=240;
Display.open(ANCHO,ALTO);
Display.loadTFT("Images/SpaceInvadersSkin.bmp")
if (platform()==HW_ESP32) then
   pause(3000)
else
    Display.update();
    pause(3000) // PequeÃ±a pausa para que se vea la pantalla
end

// Creacion del player
var player=PlayerShip();

player.speed=SHIP_SPEED;

var lastInvaderMoveTime, lastPlayerMoveTime, lastCollisionCheck, lastUFOActiveTime, lastUFOMoveTime

lastPlayerMoveTime=lastCollisionCheck=lastUFOActiveTime=lastUFOMoveTime=lastInvaderMoveTime=clock()

var numInvaders=55;

//
// Lista con construcciones de proteccion del player
var shelterList=[]

//
// Construcciones de proteccion del player
for (var i=0;i<4;i++)
    shelterList.append(ShelterBuild(20+(i*60),180))
end

//println("Pulsa una tecla para continuar")
//println("view_width ",Display.view_width)
//input();
// Obtiene el tiempo de inicio
var start = clock()

// El bucle principal del juego
for (;;)
    // Inicializa el nÃºmero de vidas del jugador
    PlayerLives = 3;

    // ContinÃºa jugando hasta que no queden vidas o hasta que el juego termine
    while(PlayerLives >= 0 and not MSG_GAME_OVER)
        // Juega hasta que todos los invasores sean derrotados o hasta que el jugador muera
        while (numInvaders != 0 and not MSG_PLAYER_DEAD)
            // Actualiza el estado del juego
            UpdateGame()

            // Comprueba si es el momento de dibujar el juego
            if (clock() - start > 30) then
                // Dibuja el juego y actualiza el tiempo de inicio
                DrawGame()
                start = clock()
            end
        end

        // Si el jugador ha muerto
        if (MSG_PLAYER_DEAD) then
            // Posiciona la explosiÃ³n en el lugar del jugador
            player.explosionSprite.x=player.sprite.x
            player.explosionSprite.y=player.sprite.y

            // Dibuja la explosiÃ³n durante 2000 milisegundos
            while (clock()-start < 2000 )
                draw.sprite(player.explosionSprite)
                DrawGame()
            end

            // Desactiva la explosiÃ³n y actualiza la pantalla
            player.explosionSprite.active=false
            DrawGame()

            // Hace una pausa de 2000 milisegundos
            println("Memoria Usada: ",memUse())
            println("Memoria Libre: ",memFree())
            pause(2000)
        end

        // Reactiva la explosiÃ³n, disminuye las vidas del jugador y restablece la bandera de muerte del jugador
        player.explosionSprite.active=true
        PlayerLives = PlayerLives - 1
        println(PlayerLives)
        MSG_PLAYER_DEAD = false

        // Si no quedan vidas, finaliza el juego
        if (PlayerLives == 0) then
            MSG_GAME_OVER = true
        end

        // Imprime el nÃºmero de vidas restantes del jugador
        println("PlayerLives : ",PlayerLives)
    end
    DrawGame();
    // Reinicia la bandera del juego
    MSG_GAME_OVER = false
    InitGame();
end
println("Memoria Usada: ",memUse())
println("Memoria Libre: ",memFree())
DrawGame();
println("Numero de invasores: ", numInvaders)
println("Score : ",PlayerScore)
print("Finalizado")
readLine();
Display.close();
