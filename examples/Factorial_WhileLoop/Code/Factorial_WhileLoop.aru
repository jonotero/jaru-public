// Calculadora de Factorial con bucle while

// Solicita al usuario que introduzca un número
println("Introduce un número para calcular su factorial:")
var numero = 7 // Simula la entrada del usuario con el número 7
var factorial = 1
var i = 1

// Comprueba si el número es negativo
if (numero < 0) then
    println("Error: El factorial no está definido para números negativos.")
elsif (numero == 0) then
    println("El factorial de 0 es 1.")
else
    // Calcula el factorial usando un bucle while
    while (i <= numero)
        factorial = factorial * i
        i++
    end

    println("El factorial de ", numero, " es ", factorial)
end
