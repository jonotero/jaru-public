// Buzzer Test

use Sound

println('Hello World from Buzzer');
// ==========================================
// Configuration
// ==========================================
const TONE_VOLUME = 180

// ==========================================
// Definition of Notes (Frequencies in Hz)
// ==========================================
var c   = 262 // Do
var d   = 294 // Re
var e   = 330 // Mi
var f   = 349 // Fa
var g   = 392 // Sol
var gS  = 415 // Sol#
var a   = 440 // La
var b   = 466 // La#

var cH  = 523 // Do (Alto)
var cSH = 554 // Do#
var dH  = 587 // Re
var dSH = 622 // Re#
var eH  = 659 // Mi
var fH  = 698 // Fa
var fSH = 740 // Fa#
var gH  = 784 // Sol
var gSH = 831 // Sol#
var aH  = 880 // La

var soundOk = Sound.init()
println(soundOk)

func PlayNote(freq, duration)
    if (soundOk) then
        Sound.tone(0, freq, TONE_VOLUME)
        pause(duration)
        Sound.stop(0)
    else
        pause(duration)
    end
end

// ==========================================
// The Imperial March
// ==========================================
println("Playing: Star Wars - Imperial March...")

// --- Part 1 ---
PlayNote(a, 500)
PlayNote(a, 500)
PlayNote(a, 500)

PlayNote(f, 350)
PlayNote(cH, 150)
PlayNote(a, 500)
PlayNote(f, 350)
PlayNote(cH, 150)
PlayNote(a, 650)

pause(500)

// --- Part 2 ---
PlayNote(eH, 500)
PlayNote(eH, 500)
PlayNote(eH, 500)

PlayNote(fH, 350)
PlayNote(cH, 150)
PlayNote(gS, 500)
PlayNote(f, 350)
PlayNote(cH, 150)
PlayNote(a, 650)

pause(500)

// --- Part 3 ---
PlayNote(aH, 500)
PlayNote(a, 300)
PlayNote(a, 150)
PlayNote(aH, 500)

PlayNote(gSH, 325)
PlayNote(gH, 175)
PlayNote(fSH, 125)
PlayNote(fH, 125)
PlayNote(fSH, 250)

pause(325)

PlayNote(a, 250)
PlayNote(dSH, 500)
PlayNote(dH, 325)
PlayNote(cSH, 175)
PlayNote(cH, 125)
PlayNote(b, 125)
PlayNote(cH, 250)

pause(350)

// --- Part 4 ---
PlayNote(f, 250)
PlayNote(gS, 500)
PlayNote(f, 350)
PlayNote(a, 125)
PlayNote(cH, 500)
PlayNote(a, 375)
PlayNote(cH, 125)
PlayNote(eH, 650)

pause(500)

// --- Repeat Part 3 ---
PlayNote(aH, 500)
PlayNote(a, 300)
PlayNote(a, 150)
PlayNote(aH, 500)

PlayNote(gSH, 325)
PlayNote(gH, 175)
PlayNote(fSH, 125)
PlayNote(fH, 125)
PlayNote(fSH, 250)

pause(325)

PlayNote(a, 250)
PlayNote(dSH, 500)
PlayNote(dH, 325)
PlayNote(cSH, 175)
PlayNote(cH, 125)
PlayNote(b, 125)
PlayNote(cH, 250)

pause(350)

// --- End ---
PlayNote(f, 250)
PlayNote(gS, 500)
PlayNote(f, 375)
PlayNote(cH, 125)
PlayNote(a, 500)
PlayNote(f, 375)
PlayNote(cH, 125)
PlayNote(a, 650)

println("End of the song.")
