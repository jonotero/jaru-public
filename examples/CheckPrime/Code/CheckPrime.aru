// Comprobador de si un número es primo

println("Introduce un número para comprobar si es primo:")
var entrada = readLine()
var numero = entrada.toInt() // Convierte la entrada a un número entero
var esPrimo = true

// Los números menores o iguales a 1 no son primos
if (numero <= 1) then
    esPrimo = false
else
    // Se comprueba la divisibilidad desde 2 hasta la mitad del número.
    // No es necesario comprobar más allá de la mitad.
    for (var i = 2; i <= numero / 2; i++)
        // Si el número es divisible por cualquier otro número, no es primo
        if (numero mod i == 0) then
            esPrimo = false
            break // Si se encuentra un divisor, se puede salir del bucle
        end
    end
end

// Muestra el resultado final
if (esPrimo) then
    println(numero, " es un número primo.")
else
    println(numero, " no es un número primo.")
end
