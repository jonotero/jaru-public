// --- ajuste del juego --------------------------------------------
// Todas las velocidades van en pixeles por SEGUNDO y se integran con
// el delta real medido con clock(). Asi la partida corre igual en
// Windows a 60 fps que en la placa a 25, sin factores de escala por
// plataforma que haya que recalibrar cada vez.
const HERO_SPEED = 78.0
const HERO_HALF = 6                  // caja de 12x12 dentro del sprite de 16
const HERO_MAX_HEARTS = 6
const HERO_START_HEARTS = 5
const ATTACK_MS = 190                // cuanto se ve la espada
const ATTACK_COOLDOWN_MS = 260
const INVULN_MS = 900                // parpadeo tras recibir un golpe
const KNOCKBACK = 70.0               // empuje al recibir dano (px/s)
const KNOCKBACK_MS = 160

// Ciclo de andar de cuatro tiempos con TRES dibujos: reposo, pie izquierdo,
// reposo, pie derecho. La pose de reposo aparece dos veces por ciclo, asi que
// dibujarla una sola vez ahorra un frame por direccion -- 1,5 KB de RAM en
// total -- sin que se note al mirarlo.
var WALK_CYCLE = [0, 1, 0, 2]
const WALK_STEP = 8.0        // pixeles recorridos por pose
const WALK_PERIOD = 32.0     // cuatro poses

const SWORD_REACH = 13               // desplazamiento del filo respecto al centro
const SWORD_HALF = 7

const SHOT_SPEED = 132.0
const SHOT_HALF = 4
// Los proyectiles salen del BORDE del que dispara y solo si hay sitio
// para verlos venir. Naciendo en el centro, un enemigo pegado al heroe le
// mete el disparo dentro sin que exista esquiva posible: eso no es
// dificultad, es un golpe gratis.
const SHOT_MUZZLE = 12
const SHOT_MIN_RANGE = 30

const SPITTER_SPEED = 42.0
const SPITTER_FIRE_MS = 2100
const SPITTER_SIGHT = 150            // alcance en pixeles para disparar
const SPITTER_BAND = 12              // margen para considerarse alineado

const HOPPER_SPEED = 96.0           // solo mientras salta
const HOPPER_HOP_MS = 420
const HOPPER_REST_MS = 620

const OGRE_SPEED = 52.0
const OGRE_FIRE_MS = 2600
const OGRE_SIGHT = 130

const BAT_SPEED = 74.0
const BAT_TURN_MS = 520

const BOSS_SPEED = 34.0
const BOSS_HP = 8
const BOSS_FIRE_MS = 1700
const BOSS_HALF = 14

const ENEMY_HALF = 6
const HURT_FLASH_MS = 140            // parpadeo del enemigo al ser golpeado

const TRANSITION_MS = 260            // deslizamiento entre pantallas
const ATTRACT_MS = 12000             // sin tocar nada -> entra la demo
const TITLE_DEMO_MS = 4000           // el titulo arranca solo en modo demo

// --- limites de las reservas -------------------------------------
// Reservas fijas: las entidades se reciclan en vez de crearse y
// destruirse, para no darle trabajo al GC en mitad del frame.
const MAX_ENEMIES = 10
const MAX_SHOTS = 12
const MAX_ITEMS = 8

// --- audio -------------------------------------------------------
// Reparto de los cinco canales, siguiendo la plantilla del 2A03 de la NES
// (dos pulsos + triangular + ruido) y usando el cuarto canal de tono, que
// aquella no tenia, para el arpegio. En la NES el arpegio habia que
// robarselo a un pulso; aqui se puede tener a la vez.
// Los canales de la musica los reparte el .jmu (melodia, contracanto, bajo,
// arpegio y ruido); aqui solo importa cual usan los efectos.

// Los efectos comparten canal con el arpegio, que es la voz que menos se
// echa de menos. No hace falta silenciar la musica: un comando de menor
// prioridad se descarta mientras suena uno mayor (JaruAudio.cpp:856), asi
// que el SFX (prioridad 1) manda y el arpegio (prioridad 0) se salta las
// notas que caigan encima.
const SFX_CH = 3
const SFX_PRIO = 1

// Volumenes. La musica y los efectos se mezclan en el mismo bus, asi que lo
// que importa es la RELACION entre ambos, no el numero absoluto.
//
// El volumen efectivo de una voz de musica es
//     volumen_de_canal * MUSIC_VOLUME / 255
// (JaruAudio.cpp:1983), y los canales van a 110..215 segun la voz. Con
// MUSIC_VOLUME a 120 la melodia sale a ~100, por debajo de cualquier efecto.
//
// OJO: arrancar una cancion resetea el volumen de musica al de su cabecera
// (JaruAudio.cpp:1391), asi que setMusicVolume hay que llamarlo DESPUES de
// cada playMusic, no una vez al inicio. Puesto al inicio parece funcionar
// hasta el primer cambio de tema.
const MUSIC_VOLUME = 120

const SFXV_SWORD = 150
const SFXV_CUT = 140
const SFXV_HIT = 165
const SFXV_KILL = 175
const SFXV_SHOT = 120       // dispara el enemigo: no debe tapar al jugador
const SFXV_HURT = 195       // el aviso mas importante que hay
const SFXV_PICKUP = 155
const SFXV_DOOR = 165
const SFXV_BOSS = 175

const MUSIC_TITLE = "Music/Title.jmu"
const MUSIC_FIELD = "Music/Field.jmu"
const MUSIC_OVER = "Music/GameOver.jmu"
const MUSIC_WIN = "Music/Victory.jmu"

const WAVE_SQUARE = 0

const MASTER_VOL_WIN = 110
const MASTER_VOL_ESP = 190

// --- acciones de entrada -----------------------------------------
enum ACTION
    UP, DOWN, LEFT, RIGHT, ATTACK, START
end

// =================================================================
// Datos
// =================================================================

// Lo que el juego lee cada frame para mover al heroe. Lo rellena la
// entrada fisica o el piloto automatico, nunca los dos a la vez.
struct Intent
    var dx = 0
    var dy = 0
    var attack = false
end

struct Hero
    var x = 0.0, y = 0.0
    var facing = 0
    var hearts = 3
    var maxHearts = 3
    var keys = 0
    var coins = 0
    var attackUntil = 0
    var attackReady = 0
    var invulnUntil = 0
    var knockX = 0.0, knockY = 0.0
    var knockUntil = 0
    var walkPhase = 0.0              // avanza con el movimiento, no con el reloj
end

struct Ent
    var kind = 0
    var x = 0.0, y = 0.0
    var vx = 0.0, vy = 0.0
    var hp = 1
    var alive = false
    var facing = 0
    var state = 0
    var nextAt = 0                   // instante del proximo cambio de estado
    var hurtUntil = 0
    var half = 6
end

struct Shot
    var kind = 0
    var x = 0.0, y = 0.0
    var vx = 0.0, vy = 0.0
    var alive = false
end

struct Item
    var kind = 0
    var x = 0.0, y = 0.0
    var alive = false
end

